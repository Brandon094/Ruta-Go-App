<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo circular con degradado amarillo/naranja -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#FFD600"
                android:endColor="#FFAB00" />
        </shape>
    </item>

    <!-- Icono de persona centrado -->
    <item
        android:drawable="@drawable/ic_person"
        android:top="20dp"
        android:bottom="20dp"
        android:left="20dp"
        android:right="20dp">
    </item>
</layer-list>
