# 🚀 Ruta-Go Gitignore - Clean Repo Standard

# --- Android Studio & IntelliJ ---
.idea/
*.iml
*.iws
.idea/workspace.xml
.idea/tasks.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/navEditor.xml
.idea/deploymentTargetDropDown.xml
.idea/render.experimental.xml
.idea/gradle.xml
out/

# --- Gradle & Build Artifacts ---
.gradle/
build/
/build/
app/build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.ap_
*.aab
*.dex
*.class
bin/

# --- Local Configuration & Secrets ---
local.properties
secrets.properties
secrets.xml
google-services.json
app/google-services.json
*.jks
*.keystore
*.p12
*.key
*.pem
service-account.json
app/src/main/assets/service-account.json

# --- Firebase ---
.firebase/
firebase-debug.log*
.firebaserc
firestore-debug.log*
ui-debug.log*

# --- Node / Firebase Functions ---
node_modules/
functions/node_modules/
firebase_functions/node_modules/
package-lock.json
npm-debug.log*

# --- OS & System Junk ---
.DS_Store
Thumbs.db
desktop.ini
*.bak
*.swp
*.tmp
*~

# --- Project Specific ---
app_backup_refactored/
*_backup.md
release/
debug/

# --- Web Portal ---
web_portal/node_modules/
web_portal/dist/
web_portal/.env
web_portal/.env.local
