<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

    <!-- 🔹 PERMISOS PARA FCM Y CONECTIVIDAD -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />

    <!-- 🔹 PERMISOS DE SEGURIDAD PARA FCM -->
    <permission
        android:name="com.chopcode.rutago.app.permission.C2D_MESSAGE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.chopcode.rutago.app.permission.C2D_MESSAGE" />

    <application
        android:name=".config.MyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrasnporteNatagaLaPlata"
        tools:targetApi="31">

        <!-- 🔹 SPLASH ACTIVITY - PUNTO DE ENTRADA PRINCIPAL (NUEVO) -->
        <activity
            android:name=".activities.common.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.Splash"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.common.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.common.ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <!-- 🔹 SERVICIO DE NOTIFICACIONES FCM -->
        <service
            android:name=".services.notifications.NotificationService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 🔹 CONFIGURACIÓN DE NOTIFICACIONES -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="high_priority_channel" />
        <meta-data
            android:name="com.xiaomi.mipush.sdk_register"
            android:value="true" />
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="true" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="true" />

        <!-- 🔹 RESTO DE ACTIVIDADES (sin cambios) -->
        <activity
            android:name=".activities.passenger.reservation.confirmReservation.ConfirmReservationActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.passenger.reservation.createReservation.CreateReservationActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.passenger.editProfile.EditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.driver.editProfile.EditDriverProfileActivity"
            android:exported="false"
            android:label="Editar Perfil Conductor"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.driver.history.DriverHistoryActivity"
            android:exported="false"
            android:label="@string/historial_reservas"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.passenger.history.ReservationHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.driver.DriverHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.passenger.PassengerHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.driver.manager.ManageSeatsActivity"
            android:exported="false"
            android:label="Gestionar Asientos"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.driver.profile.DriverProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.passenger.profile.UserProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.common.RegistrationActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.common.TicketActivity"
            android:exported="false"
            android:label="Tiquete de Viaje"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.common.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

    </application>

</manifest>