<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

    <!-- 🔹 PERMISOS PARA FCM Y CONECTIVIDAD -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />

    <!-- 🔹 PERMISOS DE SEGURIDAD PARA FCM -->
    <permission
        android:name="com.chopcode.rutago.app.permission.C2D_MESSAGE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.chopcode.rutago.app.permission.C2D_MESSAGE" />

    <application
        android:name=".config.MyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrasnporteNatagaLaPlata"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="31">

        <!-- 🔹 SPLASH ACTIVITY - PUNTO DE ENTRADA PRINCIPAL -->
        <activity
            android:name=".activities.common.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.Splash"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🔹 AUTHENTICATION -->
        <activity
            android:name=".activities.common.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.common.RegistrationActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.common.ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.common.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <!-- 🔹 CORE UNIFIED ACTIVITIES -->
        <activity
            android:name=".activities.common.HomeActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.common.history.HistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.common.profile.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.common.profile.EditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <!-- 🔹 RESERVATION FLOW -->
        <activity
            android:name=".activities.passenger.reservation.createReservation.CreateReservationActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.passenger.reservation.confirmReservation.ConfirmReservationActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.common.TicketActivity"
            android:exported="false"
            android:label="Tiquete de Viaje"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.common.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <!-- 🔹 DRIVER SPECIFIC -->
        <activity
            android:name=".activities.driver.manager.ManageSeatsActivity"
            android:exported="false"
            android:label="Gestionar Asientos"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <activity
            android:name=".activities.driver.DriverOnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.TrasnporteNatagaLaPlata.NoActionBar" />

        <!-- 🔹 SERVICIO DE NOTIFICACIONES FCM -->
        <service
            android:name=".services.notifications.NotificationService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 🔹 CONFIGURACIÓN DE NOTIFICACIONES -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="high_priority_channel" />
        <meta-data
            android:name="com.xiaomi.mipush.sdk_register"
            android:value="true" />
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="true" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="true" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.chopcode.rutago.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>