<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ==================== -->
    <!-- SISTEMA BASE DE BOTONES - ESTILOS UNIFICADOS -->
    <!-- ==================== -->

    <style name="AppButtonBase" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Body1</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="cornerRadius">24dp</item>
        <item name="elevation">2dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">20dp</item>
    </style>

    <!-- 1. BOTÓN PRIMARIO -->
    <style name="AppButton.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">@color/primary_500</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="rippleColor">@color/primary_300</item>
        <item name="elevation">4dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">20dp</item>
    </style>

    <!-- 2. BOTÓN SECUNDARIO -->
    <style name="AppButton.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">24dp</item>
        <item name="strokeColor">@color/primary_500</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/primary_500</item>
        <item name="iconTint">@color/primary_500</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="rippleColor">@color/primary_100</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- 3. BOTÓN TEXTO -->
    <style name="AppButton.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textColor">@color/primary_500</item>
        <item name="iconTint">@color/primary_500</item>
        <item name="rippleColor">@color/primary_100</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="AppButton.Text.XSmall" parent="AppButton.Text">
        <item name="android:layout_height">32dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">4dp</item>
    </style>

    <style name="AppButton.Text.Small" parent="AppButton.Text">
        <item name="android:layout_height">36dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">6dp</item>
    </style>

    <!-- 4. BOTÓN SUAVE -->
    <style name="AppButton.Soft" parent="AppButtonBase">
        <item name="backgroundTint">@color/primary_50</item>
        <item name="android:textColor">@color/primary_500</item>
        <item name="iconTint">@color/primary_500</item>
        <item name="rippleColor">@color/primary_100</item>
        <item name="elevation">1dp</item>
    </style>

    <style name="AppButton.Small">
        <item name="android:layout_height">36dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">6dp</item>
    </style>

    <style name="AppButton.XSmall">
        <item name="android:layout_height">32dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">4dp</item>
    </style>

    <style name="AppButton.Large">
        <item name="android:layout_height">56dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="cornerRadius">28dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="AppButton.Primary.Small" parent="AppButton.Primary">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">6dp</item>
    </style>

    <style name="AppButton.Primary.XSmall" parent="AppButton.Primary">
        <item name="android:layout_height">32dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">4dp</item>
    </style>

    <style name="AppButton.Secondary.Small" parent="AppButton.Secondary">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">6dp</item>
    </style>

    <style name="AppButton.Secondary.XSmall" parent="AppButton.Secondary">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">4dp</item>
    </style>

    <style name="AppButton.Soft.Small" parent="AppButton.Soft">
        <item name="android:layout_height">36dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">6dp</item>
    </style>

    <style name="FabStyle" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/primary_500</item>
        <item name="tint">@color/white</item>
        <item name="rippleColor">@color/primary_300</item>
        <item name="elevation">6dp</item>
        <item name="fabSize">normal</item>
        <item name="borderWidth">0dp</item>
        <item name="useCompatPadding">true</item>
    </style>

    <style name="FabStyle.Mini" parent="FabStyle">
        <item name="fabSize">mini</item>
    </style>

    <style name="AsientoButtonStyle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">50dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">22dp</item>
        <item name="iconTint">@null</item>
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorSurfaceVariant</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="rippleColor">@color/primary_500</item>
        <item name="elevation">1dp</item>
    </style>

    <style name="AsientoButtonStyle.Disponible" />

    <style name="AsientoButtonStyle.Seleccionado" parent="AsientoButtonStyle">
        <item name="strokeColor">@color/primary_500</item>
        <item name="strokeWidth">2.5dp</item>
        <item name="backgroundTint">@color/primary_50</item>
        <item name="rippleColor">@color/ripple_primary</item>
        <item name="elevation">2dp</item>
    </style>

    <style name="AsientoButtonStyle.Ocupado" parent="AsientoButtonStyle">
        <item name="strokeColor">@color/status_cancelled</item>
        <item name="backgroundTint">@color/status_cancelled_light</item>
        <item name="rippleColor">@color/ripple_color</item>
        <item name="android:enabled">false</item>
    </style>

    <style name="AsientoButtonStyle.Conductor" parent="AsientoButtonStyle.Ocupado">
        <item name="backgroundTint">?attr/colorSurfaceVariant</item>
        <item name="strokeColor">?attr/android:textColorSecondary</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="FilterChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipMinTouchTargetSize">0dp</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="checkedIcon">@null</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">?attr/colorSurfaceVariant</item>
    </style>

    <style name="FilterChipSelected" parent="FilterChip">
        <item name="chipBackgroundColor">@color/primary_500</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="ReservaCardStyle" parent="CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorSurfaceVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="TextTitleLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextTitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextBodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextBodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/android:textColorSecondary</item>
    </style>

    <style name="TextCaption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/android:textColorSecondary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="DividerHorizontal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?attr/colorSurfaceVariant</item>
    </style>

    <style name="AppButton" parent="AppButton.Primary" />
</resources>
