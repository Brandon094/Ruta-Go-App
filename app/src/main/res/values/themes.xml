<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema principal MD2 - ESTILO SERVICARGA (DARK THEME) -->
    <style name="Theme.TrasnporteNatagaLaPlata" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color (Navy) -->
        <item name="colorPrimary">@color/secondary_500</item>
        <item name="colorPrimaryDark">@color/secondary_900</item>
        <item name="colorPrimaryVariant">@color/secondary_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color (Orange Accent) -->
        <item name="colorSecondary">@color/primary_500</item>
        <item name="colorSecondaryVariant">@color/primary_700</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background colors (Navy) -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorBackgroundFloating">@color/surface</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <!-- Surface colors (Navy) -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>

        <!-- Error color -->
        <item name="colorError">@color/error_500</item>
        <item name="colorOnError">@color/text_on_error</item>

        <!-- Status and navigation bars (Dark) -->
        <item name="android:statusBarColor">@color/secondary_900</item>
        <item name="android:navigationBarColor">@color/secondary_900</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_tertiary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>

        <!-- Component styles -->
        <item name="materialButtonStyle">@style/ButtonStyle</item>
        <item name="cardViewStyle">@style/CardViewStyle</item>
        <item name="chipStyle">@style/ChipStyle</item>
        <item name="textInputStyle">@style/TextInputStyle</item>

        <!-- Colores para estados -->
        <item name="colorControlActivated">@color/primary_500</item>
        <item name="colorControlHighlight">@color/ripple_primary</item>
        <item name="colorControlNormal">@color/text_secondary</item>

        <!-- Asegurar tema oscuro visual -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Elevación y sombras -->
        <item name="elevationOverlayEnabled">true</item>
        <item name="elevationOverlayColor">@color/overlay</item>

        <!-- Transiciones globales -->
        <item name="android:windowAnimationStyle">@style/CustomActivityAnimation</item>
    </style>

    <!-- Estilo de animaciones de actividad -->
    <style name="CustomActivityAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- Tema sin ActionBar para actividades -->
    <style name="Theme.TrasnporteNatagaLaPlata.NoActionBar" parent="Theme.TrasnporteNatagaLaPlata">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Tema para Splash Screen -->
    <style name="Theme.TrasnporteNatagaLaPlata.Splash" parent="Theme.TrasnporteNatagaLaPlata">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/secondary_900</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowTitleSize">0dp</item>
    </style>

    <!-- Button estilo ServiCarga (Orange) -->
    <style name="ButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary_500</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingVertical">16dp</item>
        <item name="rippleColor">@color/ripple_primary</item>
        <item name="android:elevation">4dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Button estilo secundario (Outlined Orange) -->
    <style name="ButtonStyleSecondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/primary_500</item>
        <item name="strokeColor">@color/primary_500</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="rippleColor">@color/ripple_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- CardView estilo oscuro ServiCarga -->
    <style name="CardViewStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Chip estilo oscuro -->
    <style name="ChipStyle" parent="Widget.MaterialComponents.Chip.Entry">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/white</item>
        <item name="rippleColor">@color/ripple_color</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- TextInput estilo oscuro -->
    <style name="TextInputStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary_500</item>
        <item name="boxStrokeErrorColor">@color/error_500</item>
        <item name="hintTextColor">@color/primary_300</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxBackgroundColor">@color/secondary_800</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="SeatAvailable" parent="">
        <item name="android:background">@color/success_500</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="SeatSelected" parent="">
        <item name="android:background">@color/primary_500</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="SeatBooked" parent="">
        <item name="android:background">@color/secondary_400</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="AppBarStyle" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="backgroundTint">@color/secondary_900</item>
        <item name="titleTextColor">@color/primary_500</item>
        <item name="subtitleTextColor">@color/white</item>
    </style>

    <style name="ProgressBarCircularStyle" parent="android:Widget.ProgressBar">
        <item name="android:indeterminateTint">@color/primary_500</item>
    </style>

    <style name="AppDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:background">@color/secondary_800</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/secondary_200</item>
        <item name="colorAccent">@color/primary_500</item>
        <item name="colorPrimary">@color/primary_500</item>
        <!-- Estilo para los botones del diálogo -->
        <item name="buttonBarPositiveButtonStyle">@style/DialogPositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogNegativeButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogNeutralButton</item>
    </style>

    <style name="DialogPositiveButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary_500</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="rippleColor">@color/primary_500</item>
    </style>

    <style name="DialogNegativeButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/secondary_300</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="DialogNeutralButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/secondary_400</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>