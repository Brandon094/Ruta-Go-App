<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".activities.driver.GestionarAsientosActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Gestión de Asientos"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/white"
            android:background="@drawable/header_gradient_driver"
            app:menu="@menu/gestionar_asientos_menu"
            style="@style/Widget.MaterialComponents.Toolbar.Primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- CABECERA DE INFORMACIÓN -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/infoRutaCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_route"
                            app:tint="@color/primary_600"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:id="@+id/tvRutaNombre"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Natagá -> La Plata"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_time"
                            app:tint="@color/text_secondary"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:id="@+id/tvHorarioInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Horario: 08:00 AM"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/text_secondary" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="16dp"
                            android:background="@color/divider"
                            android:layout_marginHorizontal="12dp" />

                        <TextView
                            android:id="@+id/tvAsientosDispoInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Disponibles: 13"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textStyle="bold"
                            android:textColor="@color/success_700" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- LEYENDA ESTILIZADA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/leyendaCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface_variant"
                app:layout_constraintTop_toBottomOf="@id/infoRutaCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginHorizontal="8dp">
                        <View android:layout_width="12dp" android:layout_height="12dp" android:background="@color/success_500" android:layout_marginEnd="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Libre" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginHorizontal="8dp">
                        <View android:layout_width="12dp" android:layout_height="12dp" android:background="@color/error_500" android:layout_marginEnd="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="App" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginHorizontal="8dp">
                        <View android:layout_width="12dp" android:layout_height="12dp" android:background="@color/secondary_500" android:layout_marginEnd="6dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Físico" android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- INSTRUCCIONES -->
            <TextView
                android:id="@+id/tvInstrucciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Toca un asiento para marcarlo como vendido o liberarlo"
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text_tertiary"
                app:layout_constraintTop_toBottomOf="@id/leyendaCard" />

            <!-- CONTENEDOR DE BUS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/busLayoutCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="2dp"
                app:layout_constraintTop_toBottomOf="@id/tvInstrucciones">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:background="@drawable/bg_route_header">

                    <!-- SECCIÓN DELANTERA (CABINA) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_marginBottom="32dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FRENTE"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="@color/text_tertiary"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginBottom="12dp" />

                        <GridLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:columnCount="3"
                            android:rowCount="2"
                            android:alignmentMode="alignMargins">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnConductor"
                                style="@style/AsientoButtonStyle.Conductor"
                                android:layout_margin="8dp"
                                app:icon="@drawable/ic_driver" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAsiento1"
                                style="@style/AsientoButtonStyle.Disponible"
                                android:layout_margin="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAsiento2"
                                style="@style/AsientoButtonStyle.Disponible"
                                android:layout_margin="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAsiento3"
                                style="@style/AsientoButtonStyle.Disponible"
                                android:layout_margin="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAsiento4"
                                style="@style/AsientoButtonStyle.Disponible"
                                android:layout_margin="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAsiento5"
                                style="@style/AsientoButtonStyle.Disponible"
                                android:layout_margin="8dp" />
                        </GridLayout>
                    </LinearLayout>

                    <!-- PASILLO / SEPARADOR -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/divider"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginBottom="32dp" />

                    <!-- SECCIÓN TRASERA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_horizontal">

                        <!-- Bloque Izquierdo -->
                        <GridLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:columnCount="2"
                            android:layout_marginEnd="24dp">

                            <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento6" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="6dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento7" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="6dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento8" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="6dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento9" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="6dp" />
                        </GridLayout>

                        <!-- Bloque Derecho -->
                        <GridLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:columnCount="2">

                            <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento10" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="6dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento11" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="6dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento12" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="6dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento13" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="6dp" />
                        </GridLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BARRA DE NAVEGACIÓN INFERIOR -->
    <FrameLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
