<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="24dp"
            tools:context=".activities.common.LoginActivity">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.08" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.92" />

            <!-- Título con ícono -->
            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Logo con Fondo Navy Premium (Sincronizado con Ticket) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/loginCardLogo"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    app:cardBackgroundColor="@color/secondary_900"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/logoImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="5dp"
                        android:src="@drawable/logo_main"
                        android:contentDescription="@string/app_logo" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/textViewTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/inicioSesion"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_500" />
            </LinearLayout>

            <!-- Card contenedora del formulario -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loginCardView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="?attr/colorSurfaceVariant"
                app:strokeWidth="1dp"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                app:layout_constraintTop_toBottomOf="@+id/headerLayout">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Campo correo electronico -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/emailInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:startIconDrawable="@drawable/ic_email"
                        app:startIconTint="@color/primary_500"
                        app:boxStrokeColor="@color/primary_500"
                        app:boxStrokeErrorColor="@color/error_500"
                        app:hintTextColor="@color/primary_500"
                        app:boxBackgroundColor="?attr/colorSurfaceVariant"
                        android:textColorHint="?attr/android:textColorSecondary"
                        style="@style/TextInputStyle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextUser"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/correo"
                            android:inputType="textEmailAddress"
                            android:textSize="16sp"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/android:textColorSecondary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Campo Contraseña -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/passwordInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:startIconDrawable="@drawable/ic_key"
                        app:endIconDrawable="@drawable/ic_visibility_off"
                        app:startIconTint="@color/primary_500"
                        app:endIconTint="?attr/android:textColorSecondary"
                        app:endIconMode="password_toggle"
                        app:boxStrokeColor="@color/primary_500"
                        app:boxStrokeErrorColor="@color/error_500"
                        app:hintTextColor="@color/primary_500"
                        app:boxBackgroundColor="?attr/colorSurfaceVariant"
                        android:textColorHint="?attr/android:textColorSecondary"
                        style="@style/TextInputStyle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/contraseña"
                            android:inputType="textPassword"
                            android:textSize="16sp"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/android:textColorSecondary"
                            android:focusableInTouchMode="true"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Texto "Olvidé contraseña" -->
                    <TextView
                        android:id="@+id/olvidasteContraseña"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="4dp"
                        android:text="@string/forgot_password"
                        android:textColor="@color/primary_500"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"/>

                    <!-- Boton ingresar -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonIngresar"
                        style="@style/ButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/ingresar"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_login"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Separador o -->
            <LinearLayout
                android:id="@+id/separatorLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                app:layout_constraintTop_toBottomOf="@+id/loginCardView">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="?attr/colorSurfaceVariant"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:text="@string/or"
                    android:textColor="?attr/android:textColorSecondary"
                    android:textSize="14sp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="?attr/colorSurfaceVariant"/>
            </LinearLayout>

            <!-- Botón ingresar con Google -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogleSignIn"
                style="@style/ButtonStyleSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginTop="20dp"
                android:text="@string/ingresarGoogle"
                app:icon="@drawable/ic_google_logo"
                app:iconTint="@null"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:layout_constraintTop_toBottomOf="@+id/separatorLayout"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd" />

            <!-- Texto de "No tienes cuenta?" y Registrarse -->
            <LinearLayout
                android:id="@+id/registerLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@+id/btnGoogleSignIn"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintVertical_bias="1.0">

                <TextView
                    android:id="@+id/textViewRegistro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/noTieneCuenta"
                    android:textColor="?attr/android:textColorSecondary"
                    android:textSize="15sp"/>

                <TextView
                    android:id="@+id/buttonRegistro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/registrate"
                    android:textColor="@color/primary_500"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Overlay para oscurecer -->
    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/ProgressBarCircularStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:elevation="20dp" />

</FrameLayout>
