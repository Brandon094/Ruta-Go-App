<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".activities.passenger.PassengerHomeActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_500"
        android:elevation="0dp">

        <!-- Toolbar Fijo -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimaryDark"
            style="@style/Widget.MaterialComponents.Toolbar.Primary">

            <!-- Logo Icon con Forma de Pin Navy Premium (Sincronizado con Ticket) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="left"
                android:layout_marginStart="4dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/bg_pin_navy"
                    android:scaleType="fitCenter" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="13dp"
                    android:src="@drawable/logo_icon"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Contenedor Colapsable (Avatar + Estadísticas) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/primary_500"
                android:paddingHorizontal="24dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivUserAvatar"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:src="@drawable/ic_person"
                    app:civ_border_color="?attr/colorPrimaryDark"
                    app:civ_border_width="2dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="@id/ivUserAvatar"
                    app:layout_constraintBottom_toBottomOf="@id/ivUserAvatar"
                    app:layout_constraintStart_toEndOf="@id/ivUserAvatar"
                    app:layout_constraintEnd_toStartOf="@id/tvUserStatusBadge">

                    <TextView
                        android:id="@+id/tvWelcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bienvenida"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="13sp"
                        android:alpha="0.8" />

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cargando"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvUserStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="@string/status_pasajero_activo"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_active"
                    app:layout_constraintTop_toTopOf="@id/ivUserAvatar"
                    app:layout_constraintBottom_toBottomOf="@id/ivUserAvatar"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="Pasajero Activo" />

                <!-- Estadísticas Rapidas -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStatsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:strokeColor="?attr/colorSurfaceVariant"
                    app:strokeWidth="1dp"
                    app:layout_constraintTop_toBottomOf="@id/ivUserAvatar">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="12dp">

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/shimmer_stats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:shimmer_auto_start="true">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp"
                                android:weightSum="3">
                                <include layout="@layout/skeleton_stat_item" />
                                <include layout="@layout/skeleton_stat_item" />
                                <include layout="@layout/skeleton_stat_item" />
                            </LinearLayout>
                        </com.facebook.shimmer.ShimmerFrameLayout>

                        <LinearLayout
                            android:id="@+id/layout_real_stats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:visibility="gone"
                            android:weightSum="3">

                            <!-- Confirmadas -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:minHeight="48dp">
                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/ic_check"
                                    app:tint="@color/primary_500" />
                                <TextView
                                    android:id="@+id/tvReservasCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/confirmadas"
                                    android:textSize="11sp"
                                    android:textColor="?attr/android:textColorSecondary"
                                    android:gravity="center" />
                            </LinearLayout>

                            <!-- Canceladas -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:minHeight="48dp">
                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/ic_cancel"
                                    app:tint="@color/error" />
                                <TextView
                                    android:id="@+id/tvCanceladasCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/canceladas"
                                    android:textSize="11sp"
                                    android:textColor="?attr/android:textColorSecondary"
                                    android:gravity="center" />
                            </LinearLayout>

                            <!-- Total -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:minHeight="48dp">
                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/ic_checklist"
                                    app:tint="@color/success" />
                                <TextView
                                    android:id="@+id/tvTotalCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/total"
                                    android:textSize="11sp"
                                    android:textColor="?attr/android:textColorSecondary"
                                    android:gravity="center" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Leyenda Expandible -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorSurfaceVariant"
                            android:layout_marginTop="8dp" />

                        <RelativeLayout
                            android:id="@+id/legendHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="12dp"
                            android:minHeight="48dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/contador_leyenda"
                                android:textColor="?attr/android:textColorSecondary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_centerVertical="true" />

                            <ImageView
                                android:id="@+id/legendExpandIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_expand_more"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                app:tint="?attr/android:textColorSecondary"
                                android:contentDescription="@string/desc_expand_icon" />
                        </RelativeLayout>

                        <LinearLayout
                            android:id="@+id/legendContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingBottom="12dp"
                            android:visibility="gone">

                            <!-- Confirmadas -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="6dp"
                                android:gravity="center_vertical">
                                <View
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:background="@drawable/bg_circle_logout"
                                    android:backgroundTint="@color/primary_500" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:text="@string/leyenda_confirmadas_titulo"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/leyenda_confirmadas_desc"
                                    android:textColor="?attr/android:textColorSecondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Canceladas -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="6dp"
                                android:gravity="center_vertical">
                                <View
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:background="@drawable/bg_circle_logout"
                                    android:backgroundTint="@color/error" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:text="@string/leyenda_canceladas_titulo"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/leyenda_canceladas_desc"
                                    android:textColor="?attr/android:textColorSecondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- Total -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="6dp"
                                android:gravity="center_vertical">
                                <View
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:background="@drawable/bg_circle_logout"
                                    android:backgroundTint="@color/success" />
                                <TextView
                                    android:id="@+id/textView2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:text="@string/leyenda_total_titulo"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/leyenda_total_desc"
                                    android:textColor="?attr/android:textColorSecondary"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <!-- Sección Fija (Sticky): Título y Pestañas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_schedule"
                    app:tint="@color/primary_500" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/horarios_disponibles"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginBottom="4dp"
                app:tabBackground="@drawable/tab_selector_light"
                app:tabTextColor="?attr/android:textColorSecondary"
                app:tabSelectedTextColor="?attr/colorOnPrimary"
                app:tabIndicatorColor="@color/primary_500"
                app:tabIndicatorHeight="3dp"
                app:tabMode="fixed"
                app:tabGravity="fill"/>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- EL VIEWPORT PRINCIPAL -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerHorarios"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clipToPadding="false"
        android:background="?android:attr/colorBackground"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_inicio_usuarios"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        app:shimmer_auto_start="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <include layout="@layout/skeleton_item_historial" />
            <include layout="@layout/skeleton_item_historial" />
            <include layout="@layout/skeleton_item_historial" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <FrameLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:elevation="16dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
