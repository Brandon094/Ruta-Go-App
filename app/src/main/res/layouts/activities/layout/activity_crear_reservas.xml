<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".activities.passenger.reservation.createReservation.CreateReservationActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_500"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/seleccionaAsiento"
            app:titleTextColor="@color/secondary_900"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationContentDescription="@string/volver"
            app:navigationIconTint="@color/secondary_900" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.08" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.92" />

            <!-- INFO VIAJE (Plegable) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/infoViajeCardView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/secondary_800"
                app:strokeColor="@color/secondary_700"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/headerInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:id="@+id/titleContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView android:id="@+id/iconExpandCollapse" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_expand_more" app:tint="@color/primary_500" android:layout_marginEnd="12dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/infoReserva" android:textAppearance="?attr/textAppearanceTitleMedium" android:textStyle="bold" android:textColor="@color/text_primary" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/resumenInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:gravity="center_vertical|end"
                            android:orientation="horizontal">
                            <TextView android:id="@+id/tvRutaResumen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nat - LP" android:textAppearance="?attr/textAppearanceBody2" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginEnd="8dp" />
                            <TextView android:id="@+id/tvHorarioResumen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="08:00 AM" android:textAppearance="?attr/textAppearanceCaption" android:textColor="@color/text_secondary" />
                        </LinearLayout>
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/contenidoExpandible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingBottom="20dp"
                        android:visibility="gone">

                        <!-- Ruta con Icono -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_route" app:tint="@color/primary_500" android:layout_marginEnd="12dp" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:id="@+id/tvRutaSeleccionada" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cargando" android:textAppearance="?attr/textAppearanceSubtitle2" android:textStyle="bold" android:textColor="@color/text_primary" />
                                <TextView android:id="@+id/tvDescripcionRuta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cargando" android:textAppearance="?attr/textAppearanceCaption" android:textColor="@color/text_secondary" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Horario con Icono -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_time" app:tint="@color/primary_500" android:layout_marginEnd="12dp" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:id="@+id/tvHorarioSeleccionado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hora" android:textAppearance="?attr/textAppearanceSubtitle2" android:textStyle="bold" android:textColor="@color/text_primary" />
                                <TextView android:id="@+id/tvFechaViaje" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cargando" android:textAppearance="?attr/textAppearanceCaption" android:textColor="@color/text_secondary" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Vehículo con Icono -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_bus" app:tint="@color/primary_500" android:layout_marginEnd="12dp" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:id="@+id/tvVehiculoInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cargando" android:textAppearance="?attr/textAppearanceSubtitle2" android:textStyle="bold" android:textColor="@color/text_primary" />
                                <TextView android:id="@+id/tvCapacidadInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cargando" android:textAppearance="?attr/textAppearanceCaption" android:textColor="@color/text_secondary" />
                                <TextView android:id="@+id/tvCapacidadDispo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/cargando"
                                    android:textAppearance="?attr/textAppearanceCaption" android:textColor="@color/text_secondary" android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Conductor con Icono -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_driver" app:tint="@color/primary_500" android:layout_marginEnd="12dp" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Conductor" android:textAppearance="?attr/textAppearanceCaption" android:textColor="@color/text_secondary" />
                                <TextView android:id="@+id/tvNombreConductor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cargando" android:textAppearance="?attr/textAppearanceSubtitle2" android:textStyle="bold" android:textColor="@color/text_primary" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MAPA DEL BUS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/busCardView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/secondary_800"
                app:strokeColor="@color/secondary_700"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/infoViajeCardView"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cabina" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="@color/text_tertiary" android:layout_gravity="center_horizontal" android:layout_marginBottom="16dp" />

                    <GridLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:columnCount="3"
                        android:alignmentMode="alignMargins">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnConductor" style="@style/AsientoButtonStyle.Conductor" android:layout_margin="4dp" app:icon="@drawable/ic_driver" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento1" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="4dp" android:text="1" app:icon="@drawable/asiento_disponible" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento2" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="4dp" android:text="2" app:icon="@drawable/asiento_disponible" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento3" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="4dp" android:text="3" app:icon="@drawable/asiento_disponible" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento4" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="4dp" android:text="4" app:icon="@drawable/asiento_disponible" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento5" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="4dp" android:text="5" app:icon="@drawable/asiento_disponible" />
                    </GridLayout>

                    <View android:layout_width="60dp" android:layout_height="1dp" android:background="@color/outline" android:layout_gravity="center_horizontal" android:layout_marginVertical="24dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zona Trasera" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="@color/text_tertiary" android:layout_gravity="center_horizontal" android:layout_marginBottom="16dp" />

                    <GridLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:columnCount="5"
                        android:alignmentMode="alignMargins">

                        <!-- Fila 1 Trasera -->
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento6" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="4dp" android:text="6" app:icon="@drawable/asiento_disponible" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento7" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="4dp" android:text="7" app:icon="@drawable/asiento_disponible" />

                        <!-- Pasillo Central -->
                        <View android:layout_width="20dp" android:layout_height="1dp" />

                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento10" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="4dp" android:text="10" app:icon="@drawable/asiento_disponible" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento11" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="4dp" android:text="11" app:icon="@drawable/asiento_disponible" />

                        <!-- Fila 2 Trasera -->
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento8" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="4dp" android:text="8" app:icon="@drawable/asiento_disponible" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento9" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="4dp" android:text="9" app:icon="@drawable/asiento_disponible" />

                        <!-- Pasillo Central -->
                        <View android:layout_width="20dp" android:layout_height="1dp" />

                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento12" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="4dp" android:text="12" app:icon="@drawable/asiento_disponible" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento13" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="4dp" android:text="13" app:icon="@drawable/asiento_disponible" />
                    </GridLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- LEYENDA (Al Final) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/leyendaCardView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/secondary_800"
                app:strokeColor="@color/secondary_700"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/busCardView"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:padding="16dp" android:weightSum="3">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/asiento_disponible" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Libre" android:textSize="10sp" android:textColor="@color/text_secondary" android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/asiento_seleccionado" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tuyo" android:textSize="10sp" android:textColor="@color/text_secondary" android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/asiento_ocupado" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ocupado" android:textSize="10sp" android:textColor="@color/text_secondary" android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BOTONES DE ACCIÓN (FIX VISIBILIDAD) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="2"
                app:layout_constraintTop_toBottomOf="@id/leyendaCardView"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonCancelar"
                    style="@style/AppButton.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Cancelar"
                    android:textSize="14sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_cancel"
                    app:iconGravity="textStart" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonConfirmar"
                    style="@style/AppButton.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Confirmar"
                    android:textSize="14sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- INDICADOR DE SELECCIÓN FLOTANTE (ESTILO CHIP) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/selectedSeatCardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/secondary_900"
        app:strokeColor="@color/primary_500"
        app:strokeWidth="1.5dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:gravity="center_vertical">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_check" app:tint="@color/primary_500" android:layout_marginEnd="12dp" />
            <TextView android:id="@+id/tvSelectedSeat" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Asiento: 5" android:textColor="@color/text_primary" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCambiarAsiento" style="@style/AppButton.Text.Small" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cambiar" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
