<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="230dp" />

            <!-- Background del Header Naranja -->
            <View
                android:id="@+id/headerBackground"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@color/primary_500"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Shimmer Header -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmer_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:shimmer_auto_start="true"
                app:layout_constraintTop_toTopOf="parent">
                <include layout="@layout/skeleton_profile_header" />
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- Contenido del Header (Avatar + Nombre + Placa) -->
            <LinearLayout
                android:id="@+id/headerContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivProfilePicture"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:src="@drawable/ic_person"
                        app:civ_border_color="@color/secondary_900"
                        app:civ_border_width="3dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnChangePhoto"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="@color/secondary_900"
                        app:strokeColor="@color/white"
                        app:strokeWidth="1.5dp"
                        app:layout_constraintBottom_toBottomOf="@id/ivProfilePicture"
                        app:layout_constraintEnd_toEndOf="@id/ivProfilePicture"
                        android:layout_margin="2dp"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_add_photo"
                            android:padding="6dp"
                            app:tint="@color/white" />
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tvNombreUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Nombre Conductor"
                    android:textColor="@color/secondary_900"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPlacaVehiculoHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🚗 PLACA: ABC-123"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_status"
                    android:backgroundTint="@color/secondary_900"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- Shimmer Info Cards -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmer_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                app:shimmer_auto_start="true"
                app:layout_constraintTop_toTopOf="@id/guideline_header">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <include layout="@layout/skeleton_profile_card" />
                    <include layout="@layout/skeleton_profile_card" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- CONTENEDOR DE INFORMACIÓN REAL -->
            <LinearLayout
                android:id="@+id/layoutInfoReal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="@id/guideline_header"
                tools:visibility="visible">

                <!-- CARD 1: INFORMACIÓN PERSONAL -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Información Personal"
                            android:textColor="@color/primary_500"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp" />

                        <!-- Email -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="8dp"
                            android:minHeight="48dp">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_email"
                                app:tint="@color/primary_500" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email" android:textSize="11sp" android:textColor="@color/text_tertiary" />
                                <TextView android:id="@+id/tvEmail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="correo@ejemplo.com" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Teléfono -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="8dp"
                            android:minHeight="48dp">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_phone_enabled"
                                app:tint="@color/primary_500" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Teléfono" android:textSize="11sp" android:textColor="@color/text_tertiary" />
                                <TextView android:id="@+id/tvPhone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+57 300 000 0000" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- CARD 2: INFORMACIÓN DEL VEHÍCULO -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Detalles del Vehículo"
                            android:textColor="@color/primary_500"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp" />

                        <!-- Grid de info vehículo -->
                        <androidx.gridlayout.widget.GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:columnCount="2"
                            app:rowCount="2"
                            app:alignmentMode="alignMargins">

                            <!-- Modelo -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                app:layout_columnWeight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="8dp">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_car_model"
                                    app:tint="@color/primary_500" />
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Modelo" android:textSize="10sp" android:textColor="@color/text_tertiary" />
                                    <TextView android:id="@+id/tvModeloVehiculo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N/A" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Placa -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                app:layout_columnWeight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="8dp">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_license"
                                    app:tint="@color/primary_500" />
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Placa" android:textSize="10sp" android:textColor="@color/text_tertiary" />
                                    <TextView android:id="@+id/tvPlacaVehiculo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N/A" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Capacidad -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                app:layout_columnWeight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="8dp">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_seat"
                                    app:tint="@color/primary_500" />
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Capacidad" android:textSize="10sp" android:textColor="@color/text_tertiary" />
                                    <TextView android:id="@+id/tvCapacidadVehiculo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Año -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                app:layout_columnWeight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="8dp">
                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_calendar"
                                    app:tint="@color/primary_500" />
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:orientation="vertical">
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Año" android:textSize="10sp" android:textColor="@color/text_tertiary" />
                                    <TextView android:id="@+id/tvAnioVehiculo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N/A" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.gridlayout.widget.GridLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditarPerfil"
                            style="@style/AppButton.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="52dp"
                            android:layout_marginTop="20dp"
                            android:text="Editar Perfil"
                            android:textSize="14sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:icon="@drawable/ic_edit"
                            app:iconGravity="textStart" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteAccount"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="24dp"
                    android:layout_gravity="center_horizontal"
                    android:text="Solicitar borrar cuenta"
                    android:textAllCaps="false"
                    android:textColor="@color/error_color"
                    android:textSize="13sp" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:elevation="16dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
