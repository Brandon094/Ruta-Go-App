<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".activities.driver.manager.ManageSeatsActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_500"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Gestión de Asientos"
            app:titleCentered="true"
            app:titleTextColor="?attr/colorOnPrimary"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?attr/colorOnPrimary"
            android:background="@color/primary_500"
            style="@style/Widget.MaterialComponents.Toolbar.Primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.08" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.92" />

            <!-- INFO RUTA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/infoRutaCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:strokeColor="?attr/colorSurfaceVariant"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Ruta -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_route"
                            app:tint="@color/primary_500"
                            android:layout_marginEnd="12dp" />
                        <TextView
                            android:id="@+id/tvRutaNombre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Natagá -> La Plata"
                            android:textAppearance="?attr/textAppearanceSubtitle1"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <!-- Horario -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_time"
                            app:tint="@color/primary_500"
                            android:layout_marginEnd="12dp" />
                        <TextView
                            android:id="@+id/tvHorarioInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="08:00 AM"
                            android:textAppearance="?attr/textAppearanceBody2"
                            android:textColor="?attr/android:textColorSecondary" />
                    </LinearLayout>

                    <!-- Capacidad -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/asiento_disponible"
                            app:tint="@color/primary_500"
                            android:layout_marginEnd="12dp" />
                        <TextView
                            android:id="@+id/tvAsientosDispoInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="13 puestos disponibles"
                            android:textColor="?attr/android:textColorSecondary"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MAPA CONDUCTOR -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/busCardView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:strokeColor="?attr/colorSurfaceVariant"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/infoRutaCard"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cabina" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/android:textColorTertiary" android:layout_gravity="center_horizontal" android:layout_marginBottom="16dp" />

                    <GridLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:columnCount="3"
                        android:alignmentMode="alignMargins">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnConductor" style="@style/AsientoButtonStyle.Conductor" android:layout_margin="3dp" app:icon="@drawable/ic_driver" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento1" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="3dp" android:text="1" app:icon="@drawable/asiento_disponible" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento2" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="3dp" android:text="2" app:icon="@drawable/asiento_disponible" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento3" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="3dp" android:text="3" app:icon="@drawable/asiento_disponible" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento4" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="3dp" android:text="4" app:icon="@drawable/asiento_disponible" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento5" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="3dp" android:text="5" app:icon="@drawable/asiento_disponible" />
                    </GridLayout>

                    <View android:layout_width="60dp" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" android:layout_gravity="center_horizontal" android:layout_marginVertical="16dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zona Trasera" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/android:textColorTertiary" android:layout_gravity="center_horizontal" android:layout_marginBottom="16dp" />

                    <GridLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:columnCount="5"
                        android:alignmentMode="alignMargins">

                        <!-- Fila 1 Trasera -->
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento6" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="3dp" android:text="6" app:icon="@drawable/asiento_disponible" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento7" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="3dp" android:text="7" app:icon="@drawable/asiento_disponible" />

                        <!-- Pasillo Central -->
                        <View android:layout_width="16dp" android:layout_height="1dp" />

                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento10" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="3dp" android:text="10" app:icon="@drawable/asiento_disponible" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento11" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="3dp" android:text="11" app:icon="@drawable/asiento_disponible" />

                        <!-- Fila 2 Trasera -->
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento8" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="3dp" android:text="8" app:icon="@drawable/asiento_disponible" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento9" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="3dp" android:text="9" app:icon="@drawable/asiento_disponible" />

                        <!-- Pasillo Central -->
                        <View android:layout_width="16dp" android:layout_height="1dp" />

                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento12" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="3dp" android:text="12" app:icon="@drawable/asiento_disponible" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsiento13" style="@style/AsientoButtonStyle.Disponible" android:layout_margin="3dp" android:text="13" app:icon="@drawable/asiento_disponible" />
                    </GridLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- LEYENDA (Al Final) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/leyendaCardView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:cardBackgroundColor="?attr/colorSurface" app:strokeColor="?attr/colorSurfaceVariant" app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/busCardView"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:padding="16dp" android:weightSum="3">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/asiento_disponible" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Libre" android:textSize="12sp" android:textColor="?attr/android:textColorSecondary" android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/asiento_ocupado" />
                        <TextView android:id="@+id/textView3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="App" android:textSize="12sp" android:textColor="?attr/android:textColorSecondary" android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/asiento_fisico" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Local" android:textSize="12sp" android:textColor="?attr/android:textColorSecondary" android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Toca un asiento para gestionar su estado"
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="?attr/android:textColorTertiary"
                app:layout_constraintTop_toBottomOf="@id/leyendaCardView" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
