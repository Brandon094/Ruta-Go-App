<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- AppBar con TabLayout -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_500"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Editar Perfil Conductor"
            app:titleCentered="true"
            app:titleTextColor="@color/secondary_900"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/secondary_900" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_500"
            app:tabIndicatorColor="@color/secondary_900"
            app:tabSelectedTextColor="@color/secondary_900"
            app:tabTextColor="#80000000"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed">
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal" />
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vehículo" />
        </com.google.android.material.tabs.TabLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- CONTENEDOR 1: INFORMACIÓN PERSONAL -->
            <LinearLayout
                android:id="@+id/containerPersonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Card Info Actual Personal -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/secondary_800"
                    app:strokeColor="@color/secondary_700"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Datos Personales Actuales"
                            android:textColor="@color/primary_500"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp"/>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_person" app:tint="@color/text_tertiary" />
                            <TextView android:id="@+id/tvNombreActual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Cargando..." android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_phone_enabled" app:tint="@color/text_tertiary" />
                            <TextView android:id="@+id/tvTelefonoActual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Cargando..." android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_email" app:tint="@color/text_tertiary" />
                            <TextView android:id="@+id/tvCorreoActual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Cargando..." android:textColor="@color/text_secondary" android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Formulario Personal -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/TextInputStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:hint="Nuevo nombre completo"
                            app:startIconDrawable="@drawable/ic_person"
                            app:startIconTint="@color/primary_500"
                            app:boxBackgroundColor="@color/surface_1">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etNombre"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPersonName"
                                android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/TextInputStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Nuevo teléfono"
                            app:startIconDrawable="@drawable/ic_phone_enabled"
                            app:startIconTint="@color/primary_500"
                            app:boxBackgroundColor="@color/surface_1">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTelefono"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="phone"
                                android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- CONTENEDOR 2: INFORMACIÓN DEL VEHÍCULO -->
            <LinearLayout
                android:id="@+id/containerVehiculo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Card Info Actual Vehículo -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/secondary_800"
                    app:strokeColor="@color/secondary_700"
                    app:strokeWidth="1dp">
                    <androidx.gridlayout.widget.GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        app:columnCount="2">

                        <!-- Placa -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" app:layout_columnWeight="1" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_license" app:tint="@color/text_tertiary" />
                            <TextView android:id="@+id/tvPlacaActual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Placa: --" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                        </LinearLayout>

                        <!-- Marca -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" app:layout_columnWeight="1" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_copyrigth" app:tint="@color/text_tertiary" />
                            <TextView android:id="@+id/tvMarcaActual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Marca: --" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                        </LinearLayout>

                        <!-- Modelo -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" app:layout_columnWeight="1" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_car_model" app:tint="@color/text_tertiary" />
                            <TextView android:id="@+id/tvModeloActual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Modelo: --" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                        </LinearLayout>

                        <!-- Color -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" app:layout_columnWeight="1" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_color_lens" app:tint="@color/text_tertiary" />
                            <TextView android:id="@+id/tvColorActual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Color: --" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                        </LinearLayout>

                        <!-- Capacidad -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" app:layout_columnWeight="1" android:orientation="horizontal" android:gravity="center_vertical">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_capacidad" app:tint="@color/text_tertiary" />
                            <TextView android:id="@+id/tvCapacidadActual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Capacidad: --" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                        </LinearLayout>

                        <!-- Año -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" app:layout_columnWeight="1" android:orientation="horizontal" android:gravity="center_vertical">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_calendar_today" app:tint="@color/text_tertiary" />
                            <TextView android:id="@+id/tvAnioActual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Año: --" android:textColor="@color/text_secondary" android:textSize="11sp"/>
                        </LinearLayout>
                    </androidx.gridlayout.widget.GridLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Formulario Vehículo -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/TextInputStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:hint="Nueva placa"
                            app:startIconDrawable="@drawable/ic_license"
                            app:startIconTint="@color/primary_500">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPlaca" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapCharacters" android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/TextInputStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:hint="Marca"
                            app:startIconDrawable="@drawable/ic_copyrigth"
                            app:startIconTint="@color/primary_500">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etMarca" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/TextInputStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:hint="Modelo"
                            app:startIconDrawable="@drawable/ic_car_model"
                            app:startIconTint="@color/primary_500">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etModelo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/TextInputStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:hint="Color"
                            app:startIconDrawable="@drawable/ic_color_lens"
                            app:startIconTint="@color/primary_500">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etColor" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/TextInputStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:hint="Año"
                            app:startIconDrawable="@drawable/ic_calendar_today"
                            app:startIconTint="@color/primary_500">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etAnio" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/TextInputStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Capacidad"
                            app:startIconDrawable="@drawable/ic_capacidad"
                            app:startIconTint="@color/primary_500">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCapacidad" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Botones de Acción (Al final del scroll) -->
            <LinearLayout
                android:id="@+id/layoutButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="40dp"
                android:orientation="vertical">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardarCambios"
                    style="@style/AppButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:text="Guardar Cambios"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelar"
                    style="@style/AppButton.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Cancelar"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_cancel"
                    app:iconGravity="textStart" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
