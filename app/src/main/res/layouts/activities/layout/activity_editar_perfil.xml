<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- AppBar con TabLayout -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_500"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Editar Perfil Conductor"
            app:titleCentered="true"
            app:titleTextColor="?attr/colorOnPrimary"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?attr/colorOnPrimary" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_500"
            app:tabIndicatorColor="?attr/colorOnPrimary"
            app:tabSelectedTextColor="?attr/colorOnPrimary"
            app:tabTextColor="?attr/android:textColorSecondary"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed">
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal" />
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vehículo" />
        </com.google.android.material.tabs.TabLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="20dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.08" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.92" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd">

                <!-- CONTENEDOR 1: INFORMACIÓN PERSONAL -->
                <LinearLayout
                    android:id="@+id/containerPersonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- Card Info Actual Personal -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:strokeColor="?attr/colorSurfaceVariant"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Datos Personales Actuales"
                                android:textColor="@color/primary_500"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="12dp"/>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp" android:minHeight="32dp">
                                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_person" app:tint="?attr/android:textColorTertiary" />
                                <TextView android:id="@+id/tvNombreActual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Cargando..." android:textColor="?attr/android:textColorSecondary" android:textSize="13sp"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp" android:minHeight="32dp">
                                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_phone_enabled" app:tint="?attr/android:textColorTertiary" />
                                <TextView android:id="@+id/tvTelefonoActual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Cargando..." android:textColor="?attr/android:textColorSecondary" android:textSize="13sp"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="32dp">
                                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_email" app:tint="?attr/android:textColorTertiary" />
                                <TextView android:id="@+id/tvCorreoActual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Cargando..." android:textColor="?attr/android:textColorSecondary" android:textSize="13sp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Formulario Personal -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:cardCornerRadius="16dp"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:strokeColor="?attr/colorSurfaceVariant"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/TextInputStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp"
                                android:hint="Nuevo nombre completo"
                                app:startIconDrawable="@drawable/ic_person"
                                app:startIconTint="@color/primary_500"
                                app:boxBackgroundColor="?attr/colorSurfaceVariant">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etNombre"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textPersonName"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="15sp" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/TextInputStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Nuevo teléfono"
                                app:startIconDrawable="@drawable/ic_phone_enabled"
                                app:startIconTint="@color/primary_500"
                                app:boxBackgroundColor="?attr/colorSurfaceVariant">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etTelefono"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="phone"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="15sp" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- CONTENEDOR 2: INFORMACIÓN DEL VEHÍCULO -->
                <LinearLayout
                    android:id="@+id/containerVehiculo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Card Info Actual Vehículo -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:strokeColor="?attr/colorSurfaceVariant"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Datos del Vehículo Actuales"
                                android:textColor="@color/primary_500"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="12dp"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Fila 1 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:baselineAligned="false"
                                android:weightSum="2">

                                <!-- Placa -->
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp" android:minHeight="32dp">
                                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_license" app:tint="?attr/android:textColorTertiary" />
                                    <TextView android:id="@+id/tvPlacaActual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Placa: --" android:textColor="?attr/android:textColorSecondary" android:textSize="12sp"/>
                                </LinearLayout>

                                <!-- Marca -->
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp" android:minHeight="32dp">
                                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_copyrigth" app:tint="?attr/android:textColorTertiary" />
                                    <TextView android:id="@+id/tvMarcaActual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Marca: --" android:textColor="?attr/android:textColorSecondary" android:textSize="12sp"/>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Fila 2 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:baselineAligned="false"
                                android:weightSum="2">

                                <!-- Modelo -->
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp" android:minHeight="32dp">
                                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_car_model" app:tint="?attr/android:textColorTertiary" />
                                    <TextView android:id="@+id/tvModeloActual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Modelo: --" android:textColor="?attr/android:textColorSecondary" android:textSize="12sp"/>
                                </LinearLayout>

                                <!-- Color -->
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp" android:minHeight="32dp">
                                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_color_lens" app:tint="?attr/android:textColorTertiary" />
                                    <TextView android:id="@+id/tvColorActual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Color: --" android:textColor="?attr/android:textColorSecondary" android:textSize="12sp"/>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Fila 3 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:baselineAligned="false"
                                android:weightSum="2">

                                <!-- Capacidad -->
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="32dp">
                                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_capacidad" app:tint="?attr/android:textColorTertiary" />
                                    <TextView android:id="@+id/tvCapacidadActual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Capacidad: --" android:textColor="?attr/android:textColorSecondary" android:textSize="11sp"/>
                                </LinearLayout>

                                <!-- Año -->
                                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:minHeight="32dp">
                                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_calendar_today" app:tint="?attr/android:textColorTertiary" />
                                    <TextView android:id="@+id/tvAnioActual" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Año: --" android:textColor="?attr/android:textColorSecondary" android:textSize="12sp"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Formulario Vehículo -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:cardCornerRadius="16dp"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:strokeColor="?attr/colorSurfaceVariant"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/TextInputStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:hint="Nueva placa"
                                app:startIconDrawable="@drawable/ic_license"
                                app:startIconTint="@color/primary_500"
                                app:boxBackgroundColor="?attr/colorSurfaceVariant">
                                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPlaca" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapCharacters" android:textColor="?attr/colorOnSurface" android:textSize="15sp" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/TextInputStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:hint="Marca"
                                app:startIconDrawable="@drawable/ic_copyrigth"
                                app:startIconTint="@color/primary_500"
                                app:boxBackgroundColor="?attr/colorSurfaceVariant">
                                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etMarca" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface" android:textSize="15sp" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/TextInputStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:hint="Modelo"
                                app:startIconDrawable="@drawable/ic_car_model"
                                app:startIconTint="@color/primary_500"
                                app:boxBackgroundColor="?attr/colorSurfaceVariant">
                                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etModelo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface" android:textSize="15sp" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/TextInputStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:hint="Color"
                                app:startIconDrawable="@drawable/ic_color_lens"
                                app:startIconTint="@color/primary_500"
                                app:boxBackgroundColor="?attr/colorSurfaceVariant">
                                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etColor" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/colorOnSurface" android:textSize="15sp" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/TextInputStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:hint="Año"
                                app:startIconDrawable="@drawable/ic_calendar_today"
                                app:startIconTint="@color/primary_500"
                                app:boxBackgroundColor="?attr/colorSurfaceVariant">
                                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etAnio" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:textColor="?attr/colorOnSurface" android:textSize="15sp" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/TextInputStyle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Capacidad"
                                app:startIconDrawable="@drawable/ic_capacidad"
                                app:startIconTint="@color/primary_500"
                                app:boxBackgroundColor="?attr/colorSurfaceVariant">
                                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCapacidad" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:textColor="?attr/colorOnSurface" android:textSize="15sp" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Botones de Acción (Al final del scroll) -->
                <LinearLayout
                    android:id="@+id/layoutButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuardarCambios"
                        style="@style/ButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:layout_marginBottom="12dp"
                        android:text="Guardar Cambios"
                        app:icon="@drawable/ic_check"
                        app:iconGravity="textStart" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelar"
                        style="@style/ButtonStyleSecondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:text="Cancelar"
                        app:icon="@drawable/ic_cancel"
                        app:iconGravity="textStart" />
                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
