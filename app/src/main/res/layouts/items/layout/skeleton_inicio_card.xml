<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:padding="16dp"
        android:background="?attr/colorSurface">

        <View
            android:id="@+id/skeleton_circle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/skeleton_shape"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <View
            android:id="@+id/skeleton_line1"
            android:layout_width="180dp"
            android:layout_height="16dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/skeleton_shape"
            app:layout_constraintStart_toEndOf="@id/skeleton_circle"
            app:layout_constraintTop_toTopOf="@id/skeleton_circle" />

        <View
            android:id="@+id/skeleton_line2"
            android:layout_width="120dp"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/skeleton_shape"
            app:layout_constraintStart_toStartOf="@id/skeleton_line1"
            app:layout_constraintTop_toBottomOf="@id/skeleton_line1" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
