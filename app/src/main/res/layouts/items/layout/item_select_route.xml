<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/secondary_700"
    app:rippleColor="@color/primary_500"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:minHeight="72dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_logout"
            android:padding="10dp"
            android:src="@drawable/ic_route"
            app:tint="@color/primary_500" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvRouteName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nataga"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tvRouteTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hora"
                android:textSize="14sp"
                android:textColor="@color/secondary_200" />

            <TextView
                android:id="@+id/tvRouteFare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$12.000"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/warning_500"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/secondary_300"
            android:contentDescription="@string/desc_seleccionar" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
