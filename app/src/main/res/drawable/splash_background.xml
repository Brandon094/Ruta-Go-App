<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo de la app -->
    <item android:drawable="@color/primary_500" />

    <!-- Círculo blanco detrás del icono (opcional) -->
    <item
        android:width="155dp"
        android:height="155dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#756E6E" />
            <!-- Sombra suave -->
            <stroke
                android:width="1dp"
                android:color="#1A000000" />
        </shape>
    </item>

    <!-- Icono redondo más pequeño para que se vea el círculo -->
    <item
        android:width="120dp"
        android:height="120dp"
        android:drawable="@mipmap/ic_launcher_round"
        android:gravity="center" />
</layer-list>